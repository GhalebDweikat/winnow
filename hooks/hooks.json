{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv sync -q --project \"${CLAUDE_PLUGIN_ROOT}/sidecar\"",
            "timeout": 600,
            "statusMessage": "winnow: preparing sidecar environment"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"${CLAUDE_PLUGIN_ROOT}/sidecar\" winnow hook post-tool-use",
            "timeout": 60,
            "statusMessage": "winnow: judging tool output"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"${CLAUDE_PLUGIN_ROOT}/sidecar\" winnow hook user-prompt-submit",
            "timeout": 30,
            "statusMessage": "winnow: selecting context"
          }
        ]
      }
    ]
  }
}

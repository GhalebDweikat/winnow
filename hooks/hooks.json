{
  "modules": ["./winnow.ts"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"${CLAUDE_PLUGIN_ROOT}/sidecar\" python -m winnow serve --ensure",
            "timeout": 600,
            "statusMessage": "winnow: starting sidecar"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"${CLAUDE_PLUGIN_ROOT}/sidecar\" winnow serve --ensure",
            "timeout": 600,
            "statusMessage": "winnow: starting sidecar"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47311/hook/post-tool-use",
            "timeout": 60,
            "statusMessage": "winnow: judging tool output"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47311/hook/user-prompt-submit",
            "timeout": 30,
            "statusMessage": "winnow: selecting context"
          }
        ]
      }
    ]
  }
}
